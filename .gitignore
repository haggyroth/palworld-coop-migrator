# --- never commit game saves or anything derived from them -------------------
# Save files are personal data and may contain player names / Steam IDs.
*.sav
*.sav.*
SaveGames/
Players/
*.zip
*.sha256

# --- never commit credentials ------------------------------------------------
credentials.txt
*.env
.env
.env.*
secrets.*

# --- generated server config (contains passwords) ----------------------------
PalWorldSettings.ini

